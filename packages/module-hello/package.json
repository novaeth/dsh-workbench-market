{
  "name": "@dsh-workbench/module-hello",
  "version": "1.1.14-beta.2",
  "description": "最小示例模块：装上后面板里多一张卡片，用来试装试卸。",
  "type": "module",
  "exports": {
    ".": "./dist/host.js",
    "./client": "./client.js"
  },
  "files": [
    "dist",
    "client.js",
    "cordis.patch.yml",
    "CHANGELOG.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@dsh-workbench/core"
      ],
      "external": [
        "@dsh-workbench/core/client"
      ]
    },
    "workbench": {
      "apiVersion": 3,
      "unit": "hello",
      "title": {
        "zh": "示例模块",
        "en": "Sample module"
      },
      "card": {
        "order": 90
      },
      "tools": [],
      "host": {
        "inject": []
      }
    },
    "workbenchFaces": {
      "host": "src/host.ts",
      "client": "src/client.tsx"
    }
  },
  "peerDependencies": {
    "@dsh-workbench/core": "^1.0.0",
    "react": "*"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/novaeth/dsh-workbench.git",
    "directory": "packages/module-hello"
  },
  "homepage": "https://github.com/novaeth/dsh-workbench#readme",
  "bugs": {
    "url": "https://github.com/novaeth/dsh-workbench/issues"
  }
}
